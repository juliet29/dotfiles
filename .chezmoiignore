# Patterns are matched against TARGET paths (relative to $HOME), not source names.
# Ignored entries are not managed/applied by chezmoi and won't be re-added.


# # tmux plugins are installed manually via git
# .config/tmux/plugins

# nvim compiled spellfiles regenerate from .add via :mkspell
.config/nvim/spell/*.spl

# lazy.nvim lockfile: let each machine track plugin versions independently
.config/nvim/lazy-lock.json

# pet: snippets sync via gist backend; config.toml is shared 
.config/pet/snippet.toml

# ~/.claude: sync CLAUDE.md only — never let `chezmoi add ~/.claude` scoop up
# Claude Code secrets/state (.credentials.json = OAuth tokens, sessions/, projects/,
# history.jsonl). Only CLAUDE.md is in the source today; this keeps it that way.
.claude/*
!.claude/CLAUDE.md


# settings for typst-preview are specific to platform. On Autodesk moth, can't auto redirect to the browser, so have special settings
# Relocated 2026-07-25 into plugins/writing/ with the other LaTeX/writing specs;
# still managed manually per-machine, never by chezmoi.
.config/nvim/lua/plugins/writing/typst-preview.lua

# pymple.nvim: its `build = ":PympleBuild"` step (compiles a Rust helper) has
# failed on this machine, so keep the spec unmanaged for now — otherwise lazy
# would try to install + build it on every apply. Re-enable by deleting this
# line once the build succeeds (needs a working Rust toolchain).
.config/nvim/lua/plugins/python/pymple.lua
