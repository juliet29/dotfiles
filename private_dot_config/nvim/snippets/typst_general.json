{
  "Overline": {
    "prefix": "xol",
    "body": "overline($1)"
  },

  "Fraction": {
    "prefix": "xfr",
    "body": "($1)/($2)"
  },

  "Square root": {
    "prefix": "xsq",
    "body": "sqrt($1)"
  },

  "Absolute value": {
    "prefix": "xabs",
    "body": "abs($1)"
  },

  "Subscript group": {
    "prefix": "xsub",
    "body": "_($1)"
  },

  "Superscript group": {
    "prefix": "xsup",
    "body": "^($1)"
  },

  "Upright text in math": {
    "prefix": "xtt",
    "body": "\"$1\""
  },

  "Delta": {
    "prefix": "bdl",
    "body": "Delta $0"
  },

  "Delta P": {
    "prefix": "bdp",
    "body": "Delta P $0"
  }
}
